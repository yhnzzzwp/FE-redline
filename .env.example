# =====================================================================
# Frontend Redline (Next.js)
# =====================================================================

# Alamat REST API Laravel.
#
# PENTING: tanpa awalan NEXT_PUBLIC_. Variabel ini dibaca HANYA di server
# (Route Handler / Server Component) dan tidak pernah ikut ter-inline ke
# bundle JavaScript browser. Itu disengaja: browser cukup memanggil proksi
# same-origin /api/backend, sehingga alamat dan skema rute backend tidak
# terpapar ke pengunjung.
#
# Contoh produksi:
#   API_BASE_URL=https://api.redlinekomputer.co.id/api/v1
# Contoh docker compose (lewat jaringan internal, tanpa keluar internet):
#   API_BASE_URL=http://redline-web/api/v1
API_BASE_URL=http://localhost:8000/api/v1

# Nomor WhatsApp toko. Ini memang publik (dipakai di tautan wa.me),
# jadi awalan NEXT_PUBLIC_ sudah tepat.
NEXT_PUBLIC_WA_PHONE=6285640203069
